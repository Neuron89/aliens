# Copy to `web app/.env` (same folder as package.json). Values already set in the
# real environment always win over this file. Never commit .env.

# Required for the GAME NIGHT scenario generator (POST /api/generate and
# scripts/generate-pack.mjs). Without it the wizard shows setup instructions.
ANTHROPIC_API_KEY=

# Model used for generation (default claude-opus-5-5).
GENERATOR_MODEL=claude-opus-5-5

# Reasoning effort: low | medium | high | xhigh | max (default high).
GENERATOR_EFFORT=high

# Optional:
# GENERATOR_FALLBACKS=0      # disable server-side refusal fallbacks (fallbacks: "default")
# GENERATOR_MAX_TOKENS=64000 # output budget per call
# GENERATOR_MAX_CONCURRENT=2 # simultaneous generations allowed on the server
# GENERATOR_MOCK=1           # return a mutated bundled pack instead of calling Claude (UI testing)
# GENERATOR_MOCK_DELAY=350   # per-chunk delay in ms for the mock stream

# ── Voice (server text-to-speech for narration; server/tts.js) ──
# OpenAI-compatible speech endpoint. Kokoro-82M (Kokoro-FastAPI) on the GPU box:
TTS_URL=http://192.168.1.37:8880/v1
# Unset / unreachable = no server voice: READ ALOUD and the NARRATE drawer fall back to the
# browser's built-in (robotic) voice and say so.
# TTS_API_KEY=               # bearer token, only if the speech server wants one (api.openai.com does)
# TTS_MODEL=kokoro           # model name sent to the server (OpenAI: tts-1 / gpt-4o-mini-tts)
# TTS_FORMAT=mp3             # mp3 | wav
# TTS_VOICE=                 # fallback voice when the client sends none (the universe themes set their own)
# TTS_TIMEOUT_MS=60000       # per clip
# TTS_CACHE_MAX_FILES=500    # clip cache in <DATA_DIR>/tts, oldest pruned first
# TTS_CACHE_MAX_MB=200

# AI GM (docs/AI_GM.md): OpenAI-compatible chat endpoint on the GPU box (Ollama). Empty = the pack's own text.
GM_URL=http://192.168.1.37:11434/v1
GM_MODEL=hf.co/unsloth/Qwen3-30B-A3B-Instruct-2507-GGUF:Q4_K_M
GM_API_KEY=
GM_TIMEOUT_MS=240000
